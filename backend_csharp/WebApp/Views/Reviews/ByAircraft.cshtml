@model WebApp.ViewModels.Reviews.ReviewByAircraftViewModel
@{
    ViewData["Title"] = $"Reviews for {Model.Aircraft?.RegistrationNumber ?? "Aircraft"}";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Index">Aircraft</a></li>
            @if (Model.Aircraft != null)
            {
                <li class="breadcrumb-item"><a asp-controller="Aircraft" asp-action="Details" asp-route-id="@Model.Aircraft.Id">@Model.Aircraft.RegistrationNumber</a></li>
            }
            <li class="breadcrumb-item active">Reviews</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-star me-2"></i>Reviews for @(Model.Aircraft?.RegistrationNumber ?? "Aircraft")</h2>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-action="Create" asp-route-aircraftId="@Model.Aircraft?.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Write a Review
            </a>
        }
    </div>

    @if (!Model.Reviews.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No reviews yet for this aircraft. Be the first to write one!
        </div>
    }
    else
    {
        <div class="mb-3 text-muted">
            <strong>@Model.Reviews.Count() reviews</strong> &middot; 
            Average rating: <strong>@Model.Reviews.Average(r => r.Rating).ToString("0.1")</strong>/5
        </div>
        
        @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewedAt))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@review.AuthorName</strong>
                            @if (review.IsVerifiedBooking)
                            {
                                <span class="badge bg-success ms-2"><i class="bi bi-check-circle"></i> Verified</span>
                            }
                        </div>
                        <span class="text-warning">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <i class="bi bi-star"></i>
                            }
                        </span>
                    </div>
                    <p class="mt-2 mb-1">@review.Comment</p>
                    <small class="text-muted">@review.ReviewedAt.ToString("MMMM d, yyyy")</small>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        }
    }
</div>
