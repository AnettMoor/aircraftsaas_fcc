@model WebApp.ViewModels.Companies.CompanyIndexViewModel
@{
    ViewData["Title"] = "Companies";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-building me-2"></i>Companies</h2>
        @if (User.IsInRole("SystemAdmin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>New Company
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Companies.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No companies found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Company Name</th>
                        <th>Status</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Users</th>
                        <th>Aircraft</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var company in Model.Companies)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@company.Id" class="text-decoration-none fw-semibold">
                                    @company.CompanyName
                                </a>
                            </td>
                            <td>
                                @if (company.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@(company.Email ?? "—")</td>
                            <td>@(company.Phone ?? "—")</td>
                            <td>@company.CurrentUserCount / @company.MaxUsers</td>
                            <td>@company.CurrentAircraftCount / @company.MaxAircraft</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("CompanyOwner") || User.IsInRole("SystemAdmin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("SystemAdmin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@company.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this company?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
