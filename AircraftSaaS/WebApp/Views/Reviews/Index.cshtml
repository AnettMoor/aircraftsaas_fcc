@model WebApp.ViewModels.Reviews.ReviewIndexViewModel
@{
    ViewData["Title"] = "All Reviews";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-star me-2"></i>All Reviews</h2>
    
    @if (!Model.Reviews.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No reviews yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var review in Model.Reviews)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title mb-0">@review.AircraftName</h6>
                                <span class="badge bg-warning text-dark">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                            </div>
                            <p class="card-text text-muted small">@review.Comment</p>
                            <p class="card-text"><small class="text-muted">By @review.AuthorName — @review.ReviewedAt.ToString("d")</small></p>
                        </div>
                        <div class="card-footer">
                            <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
