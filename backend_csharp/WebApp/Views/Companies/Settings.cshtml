@model WebApp.ViewModels.CompanyOwner.CompanySettingsViewModel

@{
    ViewData["Title"] = App.Resources.Views.Home.CompanySettings;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@App.Resources.Views.Home.CompanySettings</h1>
            <p class="text-muted">@App.Resources.Views.Home.ManageCompanyProfile</p>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Company Profile -->
        <div class="col-lg-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">@App.Resources.Views.Home.CompanyProfile</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Settings" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="UpdateModel!.CompanyName" class="form-label"></label>
                                <input asp-for="UpdateModel!.CompanyName" class="form-control" />
                                <span asp-validation-for="UpdateModel!.CompanyName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UpdateModel!.Email" class="form-label"></label>
                                <input asp-for="UpdateModel!.Email" type="email" class="form-control" />
                                <span asp-validation-for="UpdateModel!.Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="UpdateModel!.Phone" class="form-label"></label>
                                <input asp-for="UpdateModel!.Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UpdateModel!.Address" class="form-label"></label>
                                <input asp-for="UpdateModel!.Address" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> @App.Resources.Views.Home.SaveChanges
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
