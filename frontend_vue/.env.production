# =====================================================================
# Production env — values are baked into the Vue bundle at `vite build`
# time and the bundle is then served by nginx inside the SPA container.
# These cannot be changed at container runtime; rebuild + redeploy
# the vue-frontend image after editing this file.
#
# Routing strategy (matches `vite.config.ts` dev proxy, but in prod
# the browser hits each microservice directly via its own subdomain
# instead of going through Vite's dev-server proxy):
#   /api/v1/identity   /companies /licenses /admin   →  VITE_USERS_URL
#   /api/v1/aircraft   /airports  /maintenance       →  VITE_FLEET_URL
#   /api/v1/bookings   /reviews                      →  VITE_BOOKING_URL
#
# Per-service base URLs include the ingress-nginx NodePort (`:31857`)
# because the cluster is not yet exposed on standard :443. When the
# Ingress is moved behind a real LoadBalancer / 443, drop the port
# suffix and update the matching CSP `connect-src` in
# `k8s/gateway/ingress.yaml` (or the overlay patch).
# =====================================================================
VITE_USERS_URL=https://users.aircraft.localtest.me:31857
VITE_FLEET_URL=https://fleet.aircraft.localtest.me:31857
VITE_BOOKING_URL=https://booking.aircraft.localtest.me:31857

# Legacy single-origin base — kept for back-compat with code paths
# that haven't been migrated to the per-service router yet.
# When empty, axios falls back to relative URLs and the per-path
# router in `src/api/client.ts` resolves the correct service.
VITE_API_BASE_URL=
VITE_API_VERSION=1
VITE_APP_TITLE=AircraftSaaS
