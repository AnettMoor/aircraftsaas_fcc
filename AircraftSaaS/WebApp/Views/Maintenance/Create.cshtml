@model WebApp.ViewModels.Maintenance.MaintenanceFormViewModel

@{
    ViewData["Title"] = "Add Maintenance Record";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Add Maintenance Record</h1>
            <p class="text-muted">Record a new maintenance activity</p>
        </div>
        <a asp-action="Maintenance" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Maintenance
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Form -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Maintenance Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                        {
                            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                        }
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AircraftId" class="form-label"></label>
                                <select asp-for="AircraftId" class="form-select" asp-items="@(new SelectList(Model.Aircraft, "Id", "RegistrationNumber"))">
                                    <option value="">Select Aircraft</option>
                                </select>
                                <span asp-validation-for="AircraftId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MaintenanceDate" class="form-label"></label>
                                <input asp-for="MaintenanceDate" type="date" class="form-control" />
                                <span asp-validation-for="MaintenanceDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="MaintenanceType" class="form-label"></label>
                                <input asp-for="MaintenanceType" class="form-control" placeholder="e.g., Annual Inspection" />
                                <span asp-validation-for="MaintenanceType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PerformedBy" class="form-label"></label>
                                <input asp-for="PerformedBy" class="form-control" placeholder="Mechanic/Company name" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AirframeHoursAtMaintenance" class="form-label"></label>
                                <input asp-for="AirframeHoursAtMaintenance" type="number" class="form-control" min="0" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cost" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Cost" type="number" class="form-control" min="0" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="NextDueDate" class="form-label"></label>
                                <input asp-for="NextDueDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NextDueHours" class="form-label"></label>
                                <input asp-for="NextDueHours" type="number" class="form-control" min="0" placeholder="Hours" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the maintenance work performed..."></textarea>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsCompleted" class="form-check-input" type="checkbox" id="isCompleted" />
                            <label asp-for="IsCompleted" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Save Record
                            </button>
                            <a asp-action="Maintenance" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Maintenance Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Record all maintenance activities promptly
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Keep track of airframe hours for scheduling
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Note next due dates for future planning
                        </li>
                        <li>
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Attach any relevant documentation
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}