@model WebApp.ViewModels.Companies.CompanyDetailsViewModel
@{
    ViewData["Title"] = Model.Company.CompanyName;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Companies</a></li>
            <li class="breadcrumb-item active">@Model.Company.CompanyName</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-building me-2"></i>@Model.Company.CompanyName</h4>
            @if (Model.Company.IsActive)
            {
                <span class="badge bg-success fs-6">Active</span>
            }
            else
            {
                <span class="badge bg-secondary fs-6">Inactive</span>
            }
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl>
                        <dt>Slug</dt>
                        <dd>@Model.Company.Slug</dd>

                        <dt>Email</dt>
                        <dd>@(Model.Company.Email ?? "Not provided")</dd>

                        <dt>Phone</dt>
                        <dd>@(Model.Company.Phone ?? "Not provided")</dd>

                        <dt>Address</dt>
                        <dd>@(Model.Company.Address ?? "Not provided")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl>
                        <dt>Users</dt>
                        <dd>@Model.Company.CurrentUserCount / @Model.Company.MaxUsers</dd>

                        <dt>Aircraft</dt>
                        <dd>@Model.Company.CurrentAircraftCount / @Model.Company.MaxAircraft</dd>

                        <dt>Max Bookings / Month</dt>
                        <dd>@Model.Company.MaxBookingsPerMonth</dd>

                        <dt>Created</dt>
                        <dd>@Model.Company.CreatedAt.ToString("f")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Companies
            </a>
            @if (User.IsInRole("CompanyOwner") || User.IsInRole("SystemAdmin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Company.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            @if (User.IsInRole("SystemAdmin"))
            {
                <form asp-action="Delete" asp-route-id="@Model.Company.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this company?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            }
        </div>
    </div>
</div>
