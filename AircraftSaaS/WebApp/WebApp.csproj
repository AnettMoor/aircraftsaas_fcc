<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-WebApp-f4898cd4-ce03-442c-b6a3-344f28153177</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
        <PackageReference Include="Asp.Versioning.OData.ApiExplorer" Version="8.2.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.7" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
        <PackageReference Include="NuGet.Packaging" Version="7.3.1" />
        <PackageReference Include="NuGet.Protocol" Version="7.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    </ItemGroup>

    <!-- ── Shared ──────────────────────────────────────────────────────── -->
    <ItemGroup>
      <ProjectReference Include="..\Shared\Shared.Kernel\Shared.Kernel.csproj" />
      <ProjectReference Include="..\Shared\Shared.Contracts\Shared.Contracts.csproj" />
      <ProjectReference Include="..\Shared\Shared.Messaging\Shared.Messaging.csproj" />
    </ItemGroup>

    <!-- ── Module: Users ───────────────────────────────────────────────── -->
    <!-- Domain types are available transitively via Application → Domain -->
    <ItemGroup>
      <ProjectReference Include="..\Modules\Users\Users.Application\Users.Application.csproj" />
      <ProjectReference Include="..\Modules\Users\Users.Infrastructure\Users.Infrastructure.csproj" />
    </ItemGroup>

    <!-- ── Module: Fleet (Application only — for ISystemAdminFleetService interface) ── -->
    <ItemGroup>
      <ProjectReference Include="..\Modules\Fleet\Fleet.Application\Fleet.Application.csproj" />
    </ItemGroup>

    <!-- ── Module: Booking (Application only — for ISystemAdminBookingService interface) ── -->
    <ItemGroup>
      <ProjectReference Include="..\Modules\Booking\Booking.Application\Booking.Application.csproj" />
    </ItemGroup>

    <!-- ── Module API layers — Users only (Fleet/Booking APIs now in microservices) ── -->
    <ItemGroup>
      <ProjectReference Include="..\Modules\Users\Users.Api\Users.Api.csproj" />
    </ItemGroup>

    <!-- ── Resources (shared views/localization) ───────────────────────── -->
    <ItemGroup>
      <ProjectReference Include="..\App.Resources\App.Resources.csproj" />
    </ItemGroup>

    <!-- ── Test project access to internal types ──────────────────────── -->
    <ItemGroup>
      <InternalsVisibleTo Include="WebApp.Tests" />
    </ItemGroup>

</Project>
