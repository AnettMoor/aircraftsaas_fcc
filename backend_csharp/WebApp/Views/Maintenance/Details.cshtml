@model WebApp.ViewModels.Maintenance.MaintenanceDetailsViewModel

@{
    ViewData["Title"] = "Maintenance Record Details";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Maintenance Record Details</h1>
            <p class="text-muted">View maintenance activity details</p>
        </div>
        <a asp-controller="Maintenance" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Maintenance
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Details Card -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-tools me-2"></i>@Model.Record.MaintenanceType
                    </h5>
                    @if (Model.Record.IsCompleted)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-hourglass-split me-1"></i>Pending
                        </span>
                    }
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Aircraft</label>
                            <p class="mb-0 fw-bold">@Model.Record.AircraftName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Maintenance Date</label>
                            <p class="mb-0 fw-bold">@Model.Record.MaintenanceDate.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Performed By</label>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.Record.PerformedBy) ? "—" : Model.Record.PerformedBy)</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Airframe Hours at Maintenance</label>
                            <p class="mb-0">@Model.Record.AirframeHoursAtMaintenance hrs</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Cost</label>
                            <p class="mb-0 fw-bold text-success">$@Model.Record.Cost.ToString("N2")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Next Due</label>
                            <p class="mb-0">
                                @if (Model.Record.NextDueDate.HasValue)
                                {
                                    var daysUntil = (Model.Record.NextDueDate.Value - DateTime.Today).TotalDays;
                                    var dueBadge = daysUntil < 0 ? "danger" : (daysUntil <= 30 ? "warning" : "secondary");
                                    <span class="badge bg-@dueBadge">@Model.Record.NextDueDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                                else if (Model.Record.NextDueHours.HasValue)
                                {
                                    <span class="badge bg-secondary">@Model.Record.NextDueHours hrs</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not scheduled</span>
                                }
                            </p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Record.Description?.ToString()))
                    {
                        <div class="mb-3">
                            <label class="text-muted small">Description</label>
                            <p class="mb-0">@Model.Record.Description</p>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-controller="Maintenance" asp-action="Edit" asp-route-id="@Model.Record.Id"
                       class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Edit Record
                    </a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                    <a asp-controller="Maintenance" asp-action="Index" class="btn btn-secondary ms-auto">
                        Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Record Info</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Record ID</dt>
                        <dd class="col-sm-7">
                            <small class="font-monospace">@Model.Record.Id.ToString().Substring(0, 8)...</small>
                        </dd>
                        <dt class="col-sm-5 text-muted">Created</dt>
                        <dd class="col-sm-7">
                            <small>@Model.Record.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Maintenance Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this maintenance record?</p>
                <div class="card">
                    <div class="card-body">
                        <h6>@Model.Record.MaintenanceType</h6>
                        <p class="mb-0 text-muted">
                            @Model.Record.AircraftName — @Model.Record.MaintenanceDate.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                </div>
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    This action cannot be undone.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Record.Id" method="post">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
