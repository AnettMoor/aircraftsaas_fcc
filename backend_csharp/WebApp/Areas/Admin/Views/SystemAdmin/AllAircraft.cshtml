@model WebApp.ViewModels.SystemAdmin.SystemAdminAircraftViewModel

@{
    ViewData["Title"] = App.Resources.Views.Home.AllAircraftTitle;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-airplane me-2 text-warning"></i>@App.Resources.Views.Home.AllAircraftHeading
            </h1>
            <p class="text-muted">@Model.TotalAircraft @App.Resources.Views.Home.AircraftFoundAcrossTenants</p>
        </div>
        <a asp-area="Admin" asp-controller="SystemAdmin" asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> @App.Resources.Views.Home.BackToDashboardBtn
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllAircraft" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.SearchLabel</label>
                    <input type="text" name="search" value="@Model.SearchQuery"
                           class="form-control" placeholder="@App.Resources.Views.Home.SearchRegistrationMakeModelTenant" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.AvailabilityLabel</label>
                    <select name="available" class="form-select">
                        <option value="" selected="@(Model.FilterAvailable == null)">@App.Resources.Views.Home.AllFilter</option>
                        <option value="true" selected="@(Model.FilterAvailable == true)">@App.Resources.Views.Home.AvailableOnly</option>
                        <option value="false" selected="@(Model.FilterAvailable == false)">@App.Resources.Views.Home.UnavailableOnly</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.TenantLabel</label>
                    <select name="tenantId" class="form-select">
                        <option value="" selected="@(Model.FilterTenantId == null)">@App.Resources.Views.Home.AllTenantsList</option>
                        @if (Model.TenantSelectList != null)
                        {
                            foreach (var item in Model.TenantSelectList)
                            {
                                <option value="@item.Value" selected="@(Model.FilterTenantId.ToString() == item.Value)">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> @App.Resources.Views.Home.Filter
                    </button>
                </div>
                <div class="col-md-1">
                    <a asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllAircraft"
                       class="btn btn-outline-secondary w-100" title="@App.Resources.Views.Home.Clear">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Aircraft Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@App.Resources.Views.Home.AllAircraftHeading</h5>
            <span class="badge bg-secondary">@App.Resources.Views.Home.Page @Model.Pagination.CurrentPage @App.Resources.Views.Home.Of @Model.Pagination.TotalPages</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Aircraft.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@App.Resources.Views.Home.RegistrationCol</th>
                                <th>@App.Resources.Views.Home.MakeAndModel</th>
                                <th>@App.Resources.Views.Home.YearCol</th>
                                <th class="text-end">@App.Resources.Views.Home.HourlyRateCol</th>
                                <th>@App.Resources.Views.Home.AvailabilityLabel</th>
                                <th>@App.Resources.Views.Home.Tenant</th>
                                <th>@App.Resources.Views.Home.BaseAirportCol</th>
                                <th class="text-center">@App.Resources.Views.Home.BookingsCol</th>
                                <th>@App.Resources.Views.Home.Registered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Aircraft)
                            {
                                <tr>
                                    <td><strong>@a.RegistrationNumber</strong></td>
                                    <td>@a.Make @a.Model</td>
                                    <td>@a.Year</td>
                                    <td class="text-end text-nowrap">€@a.HourlyRate.ToString("N2")/h</td>
                                    <td>
                                        @if (a.IsAvailable)
                                        {
                                            <span class="badge bg-success">@App.Resources.Views.Home.Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@App.Resources.Views.Home.Unavailable</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@a.CompanyName</span></td>
                                    <td class="text-muted small">@a.BaseAirport</td>
                                    <td class="text-center"><span class="badge bg-info">@a.TotalBookings</span></td>
                                    <td class="text-muted small">@a.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            @App.Resources.Views.Home.Showing @((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize + 1)
                            –@(Math.Min(Model.Pagination.CurrentPage * Model.Pagination.PageSize, Model.Pagination.TotalItems))
                            @App.Resources.Views.Home.Of @Model.Pagination.TotalItems
                        </span>
                        <nav aria-label="Aircraft pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.Pagination.HasPrevious ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllAircraft"
                                       asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-available="@Model.FilterAvailable"
                                       asp-route-tenantId="@Model.FilterTenantId">
                                        &laquo;
                                    </a>
                                </li>
                                @for (var p = Math.Max(1, Model.Pagination.CurrentPage - 2);
                                      p <= Math.Min(Model.Pagination.TotalPages, Model.Pagination.CurrentPage + 2);
                                      p++)
                                {
                                    <li class="page-item @(p == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllAircraft"
                                           asp-route-page="@p"
                                           asp-route-search="@Model.SearchQuery"
                                           asp-route-available="@Model.FilterAvailable"
                                           asp-route-tenantId="@Model.FilterTenantId">@p</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.Pagination.HasNext ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllAircraft"
                                       asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-available="@Model.FilterAvailable"
                                       asp-route-tenantId="@Model.FilterTenantId">
                                        &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-airplane fs-1"></i>
                    <p class="mt-2 mb-0">@App.Resources.Views.Home.NoAircraftMatchFilter</p>
                </div>
            }
        </div>
    </div>
</div>
