@model WebApp.ViewModels.Reviews.ReviewIndexViewModel
@{
    ViewData["Title"] = "My Reviews";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-star me-2"></i>My Reviews</h2>
    
    @if (!Model.Reviews.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>You haven't written any reviews yet.
        </div>
        <a asp-controller="Aircraft" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i>Browse Aircraft
        </a>
    }
    else
    {
        <div class="row">
            @foreach (var review in Model.Reviews)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title mb-0">@review.AircraftName</h6>
                                <span class="badge bg-warning text-dark">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </span>
                            </div>
                            <p class="card-text text-muted small">@review.Comment</p>
                            <p class="card-text"><small class="text-muted">@review.ReviewedAt.ToString("d")</small></p>
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
