@model IEnumerable<Booking.Application.DTOs.BookingDto>

@if (Model.Any())
{
    <div class="row">
        @foreach (var booking in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title mb-0">@booking.AircraftName</h5>
                                <small class="text-muted">
                                    <i class="bi bi-hash"></i>@booking.Id.ToString().Substring(0, 8)
                                </small>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                <span class="badge bg-@GetStatusBadgeClass(booking.Status)">
                                    @booking.Status
                                </span>
                                @if (booking.Status == Booking.Domain.Enums.EBookingStatus.Approved)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-credit-card me-1"></i>@App.Resources.Views.Home.PaymentDue
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center text-muted small mb-1">
                                <i class="bi bi-calendar-event me-2"></i>
                                @booking.StartDateTime.ToString("MMM dd, yyyy") — @booking.EndDateTime.ToString("MMM dd, yyyy")
                            </div>
                            <div class="d-flex align-items-center text-muted small mb-1">
                                <i class="bi bi-clock me-2"></i>
                                @booking.StartDateTime.ToString("HH:mm") – @booking.EndDateTime.ToString("HH:mm")
                                · @((booking.EndDateTime - booking.StartDateTime).TotalHours.ToString("F1")) @App.Resources.Views.Home.Hours
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="fs-5">$@booking.TotalAmount.ToString("N2")</strong>
                                @if (booking.PaidAt.HasValue)
                                {
                                    <small class="text-success ms-1"><i class="bi bi-check-circle"></i> @App.Resources.Views.Home.Paid</small>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>@App.Resources.Views.Home.Details
                                </a>
                                @if (booking.Status == Booking.Domain.Enums.EBookingStatus.Pending ||
                                     booking.Status == Booking.Domain.Enums.EBookingStatus.Requested ||
                                     booking.Status == Booking.Domain.Enums.EBookingStatus.Approved)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#cancelModal-@booking.Id"
                                            title="@App.Resources.Views.Home.CancelBooking">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-calendar-x fs-1"></i>
        <h5 class="mt-3">@App.Resources.Views.Home.NoBookingsLabel</h5>
        <p class="mb-3">@App.Resources.Views.Home.NoBookingsInCategory</p>
        <a asp-controller="Aircraft" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i>@App.Resources.Views.Home.FindAircraft
        </a>
    </div>
}

@functions {
    string GetStatusBadgeClass(Booking.Domain.Enums.EBookingStatus status)
    {
        return status switch
        {
            Booking.Domain.Enums.EBookingStatus.Pending => "warning text-dark",
            Booking.Domain.Enums.EBookingStatus.Requested => "info",
            Booking.Domain.Enums.EBookingStatus.Approved => "primary",
            Booking.Domain.Enums.EBookingStatus.Paid => "success",
            Booking.Domain.Enums.EBookingStatus.Completed => "dark",
            Booking.Domain.Enums.EBookingStatus.Cancelled => "secondary",
            Booking.Domain.Enums.EBookingStatus.Rejected => "danger",
            _ => "secondary"
        };
    }
}
