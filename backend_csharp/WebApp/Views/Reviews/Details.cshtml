@model WebApp.ViewModels.Reviews.ReviewDetailsViewModel
@{
    ViewData["Title"] = "Review Details";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reviews</a></li>
            <li class="breadcrumb-item active">Review Details</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Review for @Model.Review.AircraftName</h5>
            <span class="badge bg-warning text-dark fs-6">
                @for (int i = 0; i < Model.Review.Rating; i++)
                {
                    <i class="bi bi-star-fill"></i>
                }
                @for (int i = Model.Review.Rating; i < 5; i++)
                {
                    <i class="bi bi-star"></i>
                }
            </span>
        </div>
        <div class="card-body">
            @if (Model.Review.IsVerifiedBooking)
            {
                <span class="badge bg-success mb-2"><i class="bi bi-check-circle me-1"></i>Verified Booking</span>
            }
            <p class="mt-2">@Model.Review.Comment</p>
            <hr />
            <div class="row text-muted">
                <div class="col-md-4">
                    <small><strong>Author:</strong> @Model.Review.AuthorName</small>
                </div>
                <div class="col-md-4 text-center">
                    <small><strong>Type:</strong> @(Model.Review.ReviewType ?? "General")</small>
                </div>
                <div class="col-md-4 text-md-end">
                    <small><strong>Date:</strong> @Model.Review.ReviewedAt.ToString("f")</small>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-action="ByAircraft" asp-route-aircraftId="@Model.Review.AircraftId" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>All Reviews for this Aircraft
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Review.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Review.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Are you sure you want to delete this review?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </form>
        </div>
    </div>
</div>
