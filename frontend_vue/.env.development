# Development environment
# Leave VITE_API_BASE_URL empty so axios uses relative URLs (e.g. /api/v1/...)
# and Vite's dev-server proxy (see vite.config.ts) forwards each path to the
# correct microservice running on localhost (Users:5001, Fleet:5002, Booking:5003).
VITE_API_BASE_URL=
VITE_API_VERSION=1
VITE_APP_TITLE=AircraftSaaS (Dev)

# Optional overrides for the Vite proxy targets
VITE_USERS_URL=http://localhost:5001
VITE_FLEET_URL=http://localhost:5002
VITE_BOOKING_URL=http://localhost:5003
