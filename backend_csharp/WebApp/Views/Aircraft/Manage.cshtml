@model WebApp.ViewModels.CompanyOwner.AircraftListViewModel

@{
    ViewData["Title"] = "Aircraft Management";
    var activeAircraft = Model.Aircraft.Where(a => a.IsAvailable).ToList();
    var inactiveAircraft = Model.Aircraft.Where(a => !a.IsAvailable).ToList();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Aircraft Management</h1>
            <p class="text-muted">Manage your company's aircraft fleet</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Aircraft
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Manage" method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="Make" class="form-label">Make</label>
                    <input type="text" class="form-control" id="Make" name="Make" 
                           value="@Model.SearchModel?.Make" placeholder="e.g., Cessna">
                </div>
                <div class="col-md-3">
                    <label for="Model" class="form-label">Model</label>
                    <input type="text" class="form-control" id="Model" name="Model" 
                           value="@Model.SearchModel?.Model" placeholder="e.g., 172">
                </div>
                <div class="col-md-2">
                    <label for="Category" class="form-label">Category</label>
                    <select class="form-select" id="Category" name="Category">
                        <option value="">All Categories</option>
                        <option value="Single Engine" selected="@(Model.SearchModel?.Category == "Single Engine")">Single Engine</option>
                        <option value="Multi Engine" selected="@(Model.SearchModel?.Category == "Multi Engine")">Multi Engine</option>
                        <option value="TurboProp" selected="@(Model.SearchModel?.Category == "TurboProp")">TurboProp</option>
                        <option value="Helicopter" selected="@(Model.SearchModel?.Category == "Helicopter")">Helicopter</option>
                        <option value="Jet" selected="@(Model.SearchModel?.Category == "Jet")">Jet</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="Location" class="form-label">Location</label>
                    <input type="text" class="form-control" id="Location" name="Location" 
                           value="@Model.SearchModel?.Location" placeholder="Airport code">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="d-grid gap-2 w-100">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" id="aircraftTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-aircraft" type="button" role="tab">
                All Aircraft <span class="badge bg-secondary ms-1">@Model.Aircraft.Count()</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-aircraft" type="button" role="tab">
                Active <span class="badge bg-success ms-1">@activeAircraft.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="inactive-tab" data-bs-toggle="tab" data-bs-target="#inactive-aircraft" type="button" role="tab">
                Unavailable <span class="badge bg-warning text-dark ms-1">@inactiveAircraft.Count</span>
            </button>
        </li>
        @if (Model.DeletedAircraft.Any())
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="deleted-tab" data-bs-toggle="tab" data-bs-target="#deleted-aircraft" type="button" role="tab">
                    Deactivated <span class="badge bg-danger ms-1">@Model.DeletedAircraft.Count()</span>
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="aircraftTabContent">
        <!-- All Aircraft Tab -->
        <div class="tab-pane fade show active" id="all-aircraft" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Aircraft (@Model.Aircraft.Count())</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Aircraft.Any())
                    {
                        @await Html.PartialAsync("_AircraftTable", Model.Aircraft)
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-airplane fs-1 text-muted"></i>
                            <h5 class="mt-3">No Aircraft Found</h5>
                            <p class="text-muted">Add your first aircraft to get started.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i> Add Aircraft
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Active Aircraft Tab -->
        <div class="tab-pane fade" id="active-aircraft" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Active Aircraft (@activeAircraft.Count)</h5>
                </div>
                <div class="card-body p-0">
                    @if (activeAircraft.Any())
                    {
                        @await Html.PartialAsync("_AircraftTable", (IEnumerable<App.Application.DTOs.AircraftDto>)activeAircraft)
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-airplane fs-1 text-muted"></i>
                            <h5 class="mt-3">No Active Aircraft</h5>
                            <p class="text-muted">No aircraft are currently marked as available.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Unavailable Aircraft Tab -->
        <div class="tab-pane fade" id="inactive-aircraft" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Unavailable Aircraft (@inactiveAircraft.Count)</h5>
                </div>
                <div class="card-body p-0">
                    @if (inactiveAircraft.Any())
                    {
                        @await Html.PartialAsync("_AircraftTable", (IEnumerable<App.Application.DTOs.AircraftDto>)inactiveAircraft)
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle fs-1 text-success"></i>
                            <h5 class="mt-3">All Aircraft Available</h5>
                            <p class="text-muted">All aircraft are currently marked as available.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Deactivated (Deleted) Aircraft Tab -->
        @if (Model.DeletedAircraft.Any())
        {
            <div class="tab-pane fade" id="deleted-aircraft" role="tabpanel">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Deactivated Aircraft (@Model.DeletedAircraft.Count())</h5>
                        <span class="text-muted small">These aircraft have been removed from your fleet. You can reactivate them below.</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Registration</th>
                                        <th>Make & Model</th>
                                        <th>Year</th>
                                        <th>Category</th>
                                        <th>Hours</th>
                                        <th>Hourly Rate</th>
                                        <th>Base</th>
                                        <th>Rating</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aircraft in Model.DeletedAircraft)
                                    {
                                        <tr class="table-secondary">
                                            <td>
                                                <strong class="text-muted">@aircraft.RegistrationNumber</strong>
                                            </td>
                                            <td>
                                                <div class="text-muted">@aircraft.Make</div>
                                                <small class="text-muted">@aircraft.Model</small>
                                            </td>
                                            <td class="text-muted">@aircraft.Year</td>
                                            <td>
                                                <span class="badge bg-secondary">@aircraft.Category</span>
                                            </td>
                                            <td class="text-muted">@aircraft.TotalAirspeedHours hrs</td>
                                            <td class="text-muted">
                                                $@aircraft.HourlyRate
                                                <small>/hr</small>
                                            </td>
                                            <td class="text-muted">@aircraft.BaseAirportName</td>
                                            <td>
                                                @if (aircraft.ReviewCount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="text-warning me-1">★</span>
                                                        <span>@aircraft.AverageRating.ToString("F1")</span>
                                                        <small class="text-muted">(@aircraft.ReviewCount)</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No reviews</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="Restore" asp-route-id="@aircraft.Id" method="post">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate aircraft">
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reactivate
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Delete Modals *@
@foreach (var aircraft in Model.Aircraft)
{
    <div class="modal fade" id="deleteModal-@aircraft.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Deactivate Aircraft</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to deactivate <strong>@aircraft.RegistrationNumber</strong>?</p>
                    <p class="text-muted">@aircraft.Make @aircraft.Model (@aircraft.Year)</p>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        The aircraft will be moved to the Deactivated section. You can reactivate it later.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@aircraft.Id" method="post">
                        <button type="submit" class="btn btn-danger">Deactivate</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
