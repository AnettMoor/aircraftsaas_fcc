@{
    ViewData["Title"] = "Company Deactivated";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-building-x text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="card-title text-danger mb-3">Company Has Been Deactivated</h2>
                    <p class="card-text text-muted fs-5">
                        Your company account has been deactivated by the system administrator.
                        Please contact administration for further assistance.
                    </p>
                    <hr class="my-4" />
                    <div class="d-flex flex-column gap-2 align-items-center">
                        <p class="text-muted small mb-2">
                            <i class="bi bi-envelope me-1"></i>Contact your system administrator to resolve this issue.
                        </p>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
