@model IEnumerable<App.Application.DTOs.AircraftDto>

<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Registration</th>
                <th>Make & Model</th>
                <th>Year</th>
                <th>Category</th>
                <th>Hours</th>
                <th>Hourly Rate</th>
                <th>Base</th>
                <th>Status</th>
                <th>Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var aircraft in Model)
            {
                <tr>
                    <td>
                        <strong>@aircraft.RegistrationNumber</strong>
                    </td>
                    <td>
                        <div>@aircraft.Make</div>
                        <small class="text-muted">@aircraft.Model</small>
                    </td>
                    <td>@aircraft.Year</td>
                    <td>
                        <span class="badge bg-secondary">@aircraft.Category</span>
                    </td>
                    <td>@aircraft.TotalAirspeedHours hrs</td>
                    <td>
                        <strong>$@aircraft.HourlyRate</strong>
                        <small class="text-muted">/hr</small>
                    </td>
                    <td>@aircraft.BaseAirportName</td>
                    <td>
                        <span class="badge bg-@(aircraft.IsAvailable ? "success" : "warning text-dark")">
                            @(aircraft.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </td>
                    <td>
                        @if (aircraft.ReviewCount > 0)
                        {
                            <div class="d-flex align-items-center">
                                <span class="text-warning me-1">★</span>
                                <span>@aircraft.AverageRating.ToString("F1")</span>
                                <small class="text-muted">(@aircraft.ReviewCount)</small>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No reviews</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@aircraft.Id" 
                               class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@aircraft.Id" title="Deactivate">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
