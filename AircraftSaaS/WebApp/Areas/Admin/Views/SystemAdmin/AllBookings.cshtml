@model WebApp.ViewModels.SystemAdmin.SystemAdminBookingsViewModel
@using Booking.Domain.Enums

@{
    ViewData["Title"] = App.Resources.Views.Home.AllBookingsTitle;
    var statuses = Enum.GetNames(typeof(EBookingStatus));
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-calendar-check me-2 text-info"></i>@App.Resources.Views.Home.AllBookingsHeading
            </h1>
            <p class="text-muted">@Model.TotalBookings @App.Resources.Views.Home.BookingsFoundAcrossTenants</p>
        </div>
        <a asp-area="Admin" asp-controller="SystemAdmin" asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> @App.Resources.Views.Home.BackToDashboardBtn
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllBookings" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.SearchLabel</label>
                    <input type="text" name="search" value="@Model.SearchQuery"
                           class="form-control" placeholder="@App.Resources.Views.Home.SearchPilotAircraftTenant" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.StatusLabel</label>
                    <select name="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.FilterStatus))">@App.Resources.Views.Home.AllStatuses</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s" selected="@(Model.FilterStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@App.Resources.Views.Home.TenantLabel</label>
                    <select name="tenantId" class="form-select">
                        <option value="" selected="@(Model.FilterTenantId == null)">@App.Resources.Views.Home.AllTenantsList</option>
                        @if (Model.TenantSelectList != null)
                        {
                            foreach (var item in Model.TenantSelectList)
                            {
                                <option value="@item.Value" selected="@(Model.FilterTenantId.ToString() == item.Value)">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> @App.Resources.Views.Home.Filter
                    </button>
                </div>
                <div class="col-md-1">
                    <a asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllBookings"
                       class="btn btn-outline-secondary w-100" title="@App.Resources.Views.Home.Clear">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@App.Resources.Views.Home.AllBookingsHeading</h5>
            <span class="badge bg-secondary">@App.Resources.Views.Home.Page @Model.Pagination.CurrentPage @App.Resources.Views.Home.Of @Model.Pagination.TotalPages</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Bookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@App.Resources.Views.Home.Tenant</th>
                                <th>@App.Resources.Views.Home.Aircraft</th>
                                <th>@App.Resources.Views.Home.PilotCol</th>
                                <th>@App.Resources.Views.Home.StartCol</th>
                                <th>@App.Resources.Views.Home.EndCol</th>
                                <th>@App.Resources.Views.Home.Status</th>
                                <th class="text-end">@App.Resources.Views.Home.AmountCol</th>
                                <th>@App.Resources.Views.Home.CreatedCol</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Bookings)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">@b.CompanyName</span></td>
                                    <td><strong>@b.AircraftRegistration</strong></td>
                                    <td class="text-muted small">@b.PilotEmail</td>
                                    <td class="text-nowrap small">@b.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="text-nowrap small">@b.EndDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            var badgeClass = b.Status switch
                                            {
                                                EBookingStatus.Requested  => "bg-warning text-dark",
                                                EBookingStatus.Approved   => "bg-info",
                                                EBookingStatus.Paid       => "bg-primary",
                                                EBookingStatus.Completed  => "bg-success",
                                                EBookingStatus.Cancelled  => "bg-secondary",
                                                EBookingStatus.Rejected   => "bg-danger",
                                                _                         => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@b.Status</span>
                                    </td>
                                    <td class="text-end text-nowrap">€@b.TotalAmount.ToString("N2")</td>
                                    <td class="text-muted small">@b.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Pagination.TotalPages > 1)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            @App.Resources.Views.Home.Showing @((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize + 1)
                            –@(Math.Min(Model.Pagination.CurrentPage * Model.Pagination.PageSize, Model.Pagination.TotalItems))
                            @App.Resources.Views.Home.Of @Model.Pagination.TotalItems
                        </span>
                        <nav aria-label="Bookings pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.Pagination.HasPrevious ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllBookings"
                                       asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-status="@Model.FilterStatus"
                                       asp-route-tenantId="@Model.FilterTenantId">
                                        &laquo;
                                    </a>
                                </li>
                                @for (var p = Math.Max(1, Model.Pagination.CurrentPage - 2);
                                      p <= Math.Min(Model.Pagination.TotalPages, Model.Pagination.CurrentPage + 2);
                                      p++)
                                {
                                    <li class="page-item @(p == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllBookings"
                                           asp-route-page="@p"
                                           asp-route-search="@Model.SearchQuery"
                                           asp-route-status="@Model.FilterStatus"
                                           asp-route-tenantId="@Model.FilterTenantId">@p</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.Pagination.HasNext ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-area="Admin" asp-controller="SystemAdmin" asp-action="AllBookings"
                                       asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-status="@Model.FilterStatus"
                                       asp-route-tenantId="@Model.FilterTenantId">
                                        &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1"></i>
                    <p class="mt-2 mb-0">@App.Resources.Views.Home.NoBookingsMatchFilter</p>
                </div>
            }
        </div>
    </div>
</div>
